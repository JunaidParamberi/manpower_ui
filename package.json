{
  "name": "manpower-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:clean": "rm -rf .next node_modules/.cache && next dev --turbopack",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next node_modules/.cache",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "dev": "next dev",
    "build": "next build",
    "cloudflare-build": "opennextjs-cloudflare build",
    "preview": "npm run cloudflare-build && wrangler dev",
    "deploy": "npm run cloudflare-build && wrangler deploy",
    "auth:schema": "npx auth@latest generate --config lib/auth.cli.ts --adapter drizzle --dialect sqlite --output db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-link": "^3.23.2",
    "@tiptap/extension-placeholder": "^3.23.2",
    "@tiptap/extension-typography": "^3.23.2",
    "@tiptap/html": "3.23.2",
    "@tiptap/pm": "^3.23.2",
    "@tiptap/react": "^3.23.2",
    "@tiptap/starter-kit": "^3.23.2",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.40.0",
    "i18n-iso-countries": "^7.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-sound": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-links": "10.4.1",
    "@storybook/addon-themes": "10.4.1",
    "@storybook/nextjs-vite": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.14",
    "shadcn": "^4.7.0",
    "storybook": "10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.151.1"
  }
}
